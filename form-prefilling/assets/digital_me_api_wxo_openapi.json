    }
  ],
  "paths": {
    "/api/v1/forms/initialize": {
      "post": {
        "tags": [
          "forms"
        ],
        "summary": "Initialize Form",
        "description": "Initialize a new draft form with optional prefilled data.\nAccepts form fields directly in the request body.\nReturns form_id and edit URL for frontend.",
        "operationId": "forms_post_api_v1_forms_initialize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FormCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormInitializeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-ibm-skill-type": "api"
      }
    },
    "/api/v1/forms": {      
      "get": {
        "tags": [
          "forms"
        ],
        "summary": "List Forms",
        "description": "Retrieve all forms with optional filtering and pagination.",
